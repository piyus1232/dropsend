# Copy to apps/web/.env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=

# Inngest. Local: INNGEST_DEV=1 and run `bun run dev:inngest`.
# Production: remove INNGEST_DEV and set the keys from the Inngest dashboard.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Gemini API (OCR with Gemma 4). Server-only.
GEMINI_API_KEY=
